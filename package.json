{
  "name": "companion-care",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8080",
    "build": "NITRO_PRESET=node-server vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node --env-file=.env .output/server/index.mjs",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "demo:audio": "node --env-file=.env --import tsx scripts/gen-demo-audio.ts",
    "eval:guardrails": "node --env-file=.env --import tsx scripts/eval-guardrails.ts",
    "test:isolation": "node --env-file=.env scripts/test-isolation.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "@tanstack/router-plugin": "^1.168.43",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "lightningcss": "^1.30.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "version": "1.0.0",
  "description": "A calm AI companion for people with early-stage dementia, their caregivers and their doctors."
}
